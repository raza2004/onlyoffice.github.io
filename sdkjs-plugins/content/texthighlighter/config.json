{
  "name": "Text Highlighter",
  "version": "1.0.0",
  "baseUrl": "https://raza2004.github.io/onlyoffice.github.io/sdkjs-plugins/content/texthighlighter/",
  "guid": "asc.{07FD8DFA-DFE0-4089-AL24-0730933CC804}",
  "manifestVersion": "7.3.0",
  "description": "Highlight text with custom formatting",
      
  "variations": [
    {
      "description": "Text Highlighter Panel",
      "url": "index.html",
       "type":          "panel",
      "size":          [300, 600],
      "isViewer" : true,
			"EditorsSupport"  : ["word", "pdf"],
			"isVisual" : true,
			"isModal" : false,
			"isInsideMode" : true,
			"initDataType" : "text",
			"isUpdateOleOnResize" : true,
			"initOnSelectionChanged": true,                          
      "events": ["onSelectionChanged", "onClick", "onApply", "onGetSelectedText"],
    "methods": ["ApplyHighlight", "GetSelectedText"],
      "buttons": [],
       "icons": ["resources/light/icon.svg" ],
      "icons2": [
        {
          "theme": "flat",
          "style": "light",
          "100%": { "normal": "resources/light/icon.svg" },
          "125%": { "normal": "resources/light/icon.svg" },
          "150%": { "normal": "resources/light/icon.svg" },
          "175%": { "normal": "resources/light/icon.svg" },
          "200%": { "normal": "resources/light/icon.svg" },
          "default": { "normal": "resources/light/icon.svg" }
        },
        {
          "theme": "flatDark",
          "style": "dark",
          "100%": { "normal": "resources/dark/icon.svg" },
          "125%": { "normal": "resources/dark/icon.svg" },
          "150%": { "normal": "resources/dark/icon.svg" },
          "175%": { "normal": "resources/dark/icon.svg" },
          "200%": { "normal": "resources/dark/icon.svg" }
        }
      ],

       "store": {
        "background": {
          "light": "#042B42",
          "dark":  "#5f55af"
        },
        "categories": ["work","specAbilities"],
        "icons": {
          "light": "resources/store/icons",
          "dark":  "resources/store/icons"
        }
      }
    }
  ]
}
